# Database connection string
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/crypto_payment_service?sslmode=disable

# Webhook server port (default: 8080)
PORT=8080

# Optional: HMAC secret for webhook signature verification
# If set, requests must include X-Signature header with HMAC-SHA256 signature
# WEBHOOK_SECRET=your-secret-here

# Optional: Log level (default: info)
LOG_LEVEL=info
